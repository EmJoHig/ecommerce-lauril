# MongoDB Atlas (never commit a real connection string)
MONGODB_URI=

# Application and sessions
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="lauril_session"
SESSION_TTL_DAYS="30"
CUSTOMER_SESSION_COOKIE_NAME="lauril_customer_session"
CUSTOMER_SESSION_TTL_DAYS="30"
PASSWORD_RESET_TTL_MINUTES="30"
CART_COOKIE_NAME="lauril_cart"
CART_TTL_DAYS="30"
ORDER_RESERVATION_MINUTES="15"
BCRYPT_COST="12"

# Optional initial admin for `npm run db:seed` (minimum 12 characters)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Required in production for the S3-compatible ObjectStorage adapter
# For Cloudflare R2, set the account-specific S3 API endpoint and a public bucket/custom-domain base URL.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Required in production for transactional emails through Resend
RESEND_API_KEY=""
EMAIL_FROM="Lauril <no-reply@example.com>"
