# PostgreSQL (use an unprivileged application user in production)
DATABASE_URL="postgresql://lauril:change-me@localhost:5433/lauril?schema=public"
POSTGRES_DB="lauril"
POSTGRES_USER="lauril"
POSTGRES_PASSWORD="change-me"
POSTGRES_PORT="5433"

# Application and sessions
APP_URL="http://localhost:3000"
SESSION_COOKIE_NAME="lauril_session"
SESSION_TTL_DAYS="30"
CART_COOKIE_NAME="lauril_cart"
CART_TTL_DAYS="30"
BCRYPT_COST="12"

# Optional initial admin for `npm run db:seed` (minimum 12 characters)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Reserved for the future S3-compatible ObjectStorage adapter
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
