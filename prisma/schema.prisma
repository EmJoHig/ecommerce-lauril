generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("user_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
  CANCELLATION
  CORRECTION

  @@map("inventory_movement_type")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum CustomerStatus {
  ACTIVE
  DISABLED

  @@map("customer_status")
}

enum ShippingMethodType {
  PICKUP
  FLAT_RATE
  LOCAL_DELIVERY
  TO_COORDINATE

  @@map("shipping_method_type")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_REJECTED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("order_status")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  firstName           String               @map("first_name") @db.VarChar(100)
  lastName            String               @map("last_name") @db.VarChar(100)
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementAdmin")
  auditLogs           AuditLog[]
  orderStatusChanges  OrderStatusHistory[] @relation("OrderStatusActor")
  orderNotes          OrderNote[]          @relation("OrderNoteActor")
  customer            Customer?

  @@index([status])
  @@map("users")
}

model Customer {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @unique @map("user_id") @db.Uuid
  phone     String            @db.VarChar(30)
  document  String?           @db.VarChar(50)
  status    CustomerStatus    @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  carts     Cart[]
  orders    Order[]

  @@index([status, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id                 String   @id @default(uuid()) @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  label              String   @db.VarChar(80)
  recipientFirstName String   @map("recipient_first_name") @db.VarChar(100)
  recipientLastName  String   @map("recipient_last_name") @db.VarChar(100)
  phone              String   @db.VarChar(30)
  street             String   @db.VarChar(160)
  streetNumber       String   @map("street_number") @db.VarChar(30)
  floorApartment     String?  @map("floor_apartment") @db.VarChar(80)
  city               String   @db.VarChar(120)
  province           String   @db.VarChar(120)
  postalCode         String   @map("postal_code") @db.VarChar(20)
  references         String?  @db.VarChar(500)
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault, createdAt])
  @@map("customer_addresses")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(200)
  slug             String            @unique @db.VarChar(180)
  shortDescription String?           @map("short_description") @db.VarChar(500)
  description      String?           @db.Text
  status           ProductStatus     @default(DRAFT)
  featured         Boolean           @default(false)
  seoTitle         String?           @map("seo_title") @db.VarChar(70)
  seoDescription   String?           @map("seo_description") @db.VarChar(170)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants         ProductVariant[]
  images           ProductImage[]
  categories       ProductCategory[]
  orderItems       OrderItem[]

  @@index([status, publishedAt])
  @@index([status, updatedAt])
  @@index([featured, status])
  @@map("products")
}

model ProductVariant {
  id                      String      @id @default(uuid()) @db.Uuid
  productId               String      @map("product_id") @db.Uuid
  sku                     String      @unique @db.VarChar(100)
  name                    String      @db.VarChar(160)
  attributes              Json        @default("{}")
  priceInCents            BigInt      @map("price_in_cents")
  promotionalPriceInCents BigInt?     @map("promotional_price_in_cents")
  costInCents             BigInt?     @map("cost_in_cents")
  isDefault               Boolean     @default(false) @map("is_default")
  isActive                Boolean     @default(true) @map("is_active")
  sortOrder               Int         @default(0) @map("sort_order")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  product                 Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory               Inventory?
  cartItems               CartItem[]
  orderItems              OrderItem[]

  @@index([productId, isActive, sortOrder])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  objectKey String   @map("object_key") @db.VarChar(500)
  url       String   @db.VarChar(1000)
  altText   String   @map("alt_text") @db.VarChar(250)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, objectKey])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model Category {
  id             String            @id @default(uuid()) @db.Uuid
  parentId       String?           @map("parent_id") @db.Uuid
  name           String            @db.VarChar(160)
  slug           String            @unique @db.VarChar(180)
  description    String?           @db.Text
  isActive       Boolean           @default(true) @map("is_active")
  sortOrder      Int               @default(0) @map("sort_order")
  seoTitle       String?           @map("seo_title") @db.VarChar(70)
  seoDescription String?           @map("seo_description") @db.VarChar(170)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]        @relation("CategoryTree")
  products       ProductCategory[]

  @@index([parentId, isActive, sortOrder])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_categories")
}

model Inventory {
  id            String              @id @default(uuid()) @db.Uuid
  variantId     String              @unique @map("variant_id") @db.Uuid
  stockOnHand   Int                 @default(0) @map("stock_on_hand")
  stockReserved Int                 @default(0) @map("stock_reserved")
  minimumStock  Int                 @default(0) @map("minimum_stock")
  version       Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant       ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements     InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  inventoryId   String                @map("inventory_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  stockBefore   Int                   @map("stock_before")
  stockAfter    Int                   @map("stock_after")
  reason        String                @db.VarChar(500)
  referenceType String?               @map("reference_type") @db.VarChar(80)
  referenceId   String?               @map("reference_id") @db.VarChar(120)
  adminUserId   String?               @map("admin_user_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  inventory     Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  adminUser     User?                 @relation("InventoryMovementAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@index([adminUserId, createdAt])
  @@map("inventory_movements")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  guestTokenHash String?    @unique @map("guest_token_hash") @db.Char(64)
  customerId     String?    @map("customer_id") @db.Uuid
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  version        Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items          CartItem[]
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          Order?

  @@index([status, expiresAt])
  @@index([customerId, status, updatedAt])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id                       String         @id @default(uuid()) @db.Uuid
  cartId                   String         @map("cart_id") @db.Uuid
  variantId                String         @map("variant_id") @db.Uuid
  quantity                 Int
  unitPriceSnapshotInCents BigInt         @map("unit_price_snapshot_in_cents")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart                     Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant                  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model ShippingMethod {
  id                      String             @id @default(uuid()) @db.Uuid
  code                    String             @unique @db.VarChar(80)
  name                    String             @db.VarChar(120)
  description             String?            @db.VarChar(500)
  type                    ShippingMethodType
  costInCents             BigInt             @default(0) @map("cost_in_cents")
  requiresAddress         Boolean            @default(true) @map("requires_address")
  minimumSubtotalInCents  BigInt?            @map("minimum_subtotal_in_cents")
  freeShippingFromInCents BigInt?            @map("free_shipping_from_in_cents")
  isActive                Boolean            @default(true) @map("is_active")
  sortOrder               Int                @default(0) @map("sort_order")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders                  Order[]

  @@index([isActive, sortOrder, name])
  @@map("shipping_methods")
}

model Order {
  id                         String               @id @default(uuid()) @db.Uuid
  number                     BigInt               @unique @default(autoincrement()) @map("order_number")
  cartId                     String               @unique @map("cart_id") @db.Uuid
  customerId                 String?              @map("customer_id") @db.Uuid
  shippingMethodId           String               @map("shipping_method_id") @db.Uuid
  checkoutKeyHash            String               @unique @map("checkout_key_hash") @db.Char(64)
  guestAccessTokenHash       String?              @unique @map("guest_access_token_hash") @db.Char(64)
  status                     OrderStatus          @default(PENDING_PAYMENT)
  currency                   String               @default("ARS") @db.Char(3)
  buyerFirstName             String               @map("buyer_first_name") @db.VarChar(100)
  buyerLastName              String               @map("buyer_last_name") @db.VarChar(100)
  buyerEmail                 String               @map("buyer_email") @db.VarChar(320)
  buyerPhone                 String               @map("buyer_phone") @db.VarChar(30)
  shippingMethodName         String               @map("shipping_method_name") @db.VarChar(120)
  shippingMethodType         ShippingMethodType   @map("shipping_method_type")
  shippingRequiresAddress    Boolean              @map("shipping_requires_address")
  shippingRecipientFirstName String?              @map("shipping_recipient_first_name") @db.VarChar(100)
  shippingRecipientLastName  String?              @map("shipping_recipient_last_name") @db.VarChar(100)
  shippingPhone              String?              @map("shipping_phone") @db.VarChar(30)
  shippingStreet             String?              @map("shipping_street") @db.VarChar(160)
  shippingStreetNumber       String?              @map("shipping_street_number") @db.VarChar(30)
  shippingFloorApartment     String?              @map("shipping_floor_apartment") @db.VarChar(80)
  shippingCity               String?              @map("shipping_city") @db.VarChar(120)
  shippingProvince           String?              @map("shipping_province") @db.VarChar(120)
  shippingPostalCode         String?              @map("shipping_postal_code") @db.VarChar(20)
  shippingReferences         String?              @map("shipping_references") @db.VarChar(500)
  itemsSubtotalInCents       BigInt               @map("items_subtotal_in_cents")
  shippingAmountInCents      BigInt               @map("shipping_amount_in_cents")
  discountAmountInCents      BigInt               @default(0) @map("discount_amount_in_cents")
  totalInCents               BigInt               @map("total_in_cents")
  paymentExpiresAt           DateTime             @map("payment_expires_at") @db.Timestamptz(3)
  reservationReleasedAt      DateTime?            @map("reservation_released_at") @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  cart                       Cart                 @relation(fields: [cartId], references: [id], onDelete: Restrict)
  customer                   Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingMethod             ShippingMethod       @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  notes                      OrderNote[]

  @@index([customerId, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([status, createdAt])
  @@index([shippingMethodId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  productId        String?         @map("product_id") @db.Uuid
  productVariantId String?         @map("product_variant_id") @db.Uuid
  productName      String          @map("product_name") @db.VarChar(200)
  variantName      String          @map("variant_name") @db.VarChar(160)
  sku              String          @db.VarChar(100)
  unitPriceInCents BigInt          @map("unit_price_in_cents")
  quantity         Int
  subtotalInCents  BigInt          @map("subtotal_in_cents")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  reason      String       @db.VarChar(500)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User?        @relation("OrderStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
  @@map("order_status_history")
}

model OrderNote {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  content     String   @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User     @relation("OrderNoteActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("order_notes")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(120)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
