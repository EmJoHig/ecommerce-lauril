generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED

  @@map("user_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status")
}

enum InventoryMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
  CANCELLATION
  CORRECTION

  @@map("inventory_movement_type")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum CustomerStatus {
  ACTIVE
  DISABLED

  @@map("customer_status")
}

enum ShippingMethodType {
  PICKUP
  FLAT_RATE
  LOCAL_DELIVERY
  TO_COORDINATE

  @@map("shipping_method_type")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_REJECTED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("order_status")
}

model User {
  id                  String               @id @default(uuid()) @map("_id")
  email               String               @unique
  passwordHash        String               @map("password_hash")
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  status              UserStatus           @default(ACTIVE)
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  inventoryMovements  InventoryMovement[]  @relation("InventoryMovementAdmin")
  auditLogs           AuditLog[]
  orderStatusChanges  OrderStatusHistory[] @relation("OrderStatusActor")
  orderNotes          OrderNote[]          @relation("OrderNoteActor")
  customerNotes       CustomerNote[]       @relation("CustomerNoteActor")
  customer            Customer?

  @@index([status])
  @@map("users")
}

model Customer {
  id        String            @id @default(uuid()) @map("_id")
  userId    String            @unique @map("user_id")
  phone     String
  document  String?
  status    CustomerStatus    @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  carts     Cart[]
  orders    Order[]
  notes     CustomerNote[]

  @@index([status, createdAt])
  @@map("customers")
}

model CustomerNote {
  id          String   @id @default(uuid()) @map("_id")
  customerId  String   @map("customer_id")
  actorUserId String   @map("actor_user_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor       User     @relation("CustomerNoteActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("customer_notes")
}

model CustomerAddress {
  id                 String   @id @default(uuid()) @map("_id")
  customerId         String   @map("customer_id")
  label              String
  recipientFirstName String   @map("recipient_first_name")
  recipientLastName  String   @map("recipient_last_name")
  phone              String
  street             String
  streetNumber       String   @map("street_number")
  floorApartment     String?  @map("floor_apartment")
  city               String
  province           String
  postalCode         String   @map("postal_code")
  references         String?
  isDefault          Boolean  @default(false) @map("is_default")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isDefault, createdAt])
  @@map("customer_addresses")
}

model Role {
  id          String           @id @default(uuid()) @map("_id")
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @map("_id")
  code        String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @map("_id")
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @map("_id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @map("_id")
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Product {
  id               String            @id @default(uuid()) @map("_id")
  name             String
  slug             String            @unique
  shortDescription String?           @map("short_description")
  description      String?
  status           ProductStatus     @default(DRAFT)
  featured         Boolean           @default(false)
  seoTitle         String?           @map("seo_title")
  seoDescription   String?           @map("seo_description")
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  variants         ProductVariant[]
  images           ProductImage[]
  categories       ProductCategory[]
  orderItems       OrderItem[]

  @@index([status, publishedAt])
  @@index([status, updatedAt])
  @@index([featured, status])
  @@map("products")
}

model ProductVariant {
  id                      String      @id @default(uuid()) @map("_id")
  productId               String      @map("product_id")
  sku                     String      @unique
  name                    String
  attributes              Json        @default("{}")
  fragranceKey            String?     @map("fragrance_key")
  priceInCents            BigInt      @map("price_in_cents")
  promotionalPriceInCents BigInt?     @map("promotional_price_in_cents")
  costInCents             BigInt?     @map("cost_in_cents")
  isDefault               Boolean     @default(false) @map("is_default")
  isActive                Boolean     @default(true) @map("is_active")
  sortOrder               Int         @default(0) @map("sort_order")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  product                 Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory               Inventory?
  cartItems               CartItem[]
  orderItems              OrderItem[]

  @@index([productId, isActive, sortOrder])
  @@index([fragranceKey, isActive, isDefault])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @map("_id")
  productId String   @map("product_id")
  objectKey String   @map("object_key")
  url       String
  altText   String   @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, objectKey])
  @@index([productId, sortOrder])
  @@map("product_images")
}

model Category {
  id             String            @id @default(uuid()) @map("_id")
  parentId       String?           @map("parent_id")
  name           String
  slug           String            @unique
  description    String?
  isActive       Boolean           @default(true) @map("is_active")
  sortOrder      Int               @default(0) @map("sort_order")
  seoTitle       String?           @map("seo_title")
  seoDescription String?           @map("seo_description")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       Category[]        @relation("CategoryTree")
  products       ProductCategory[]

  @@index([parentId, isActive, sortOrder])
  @@map("categories")
}

model ProductCategory {
  id         String   @id @default(uuid()) @map("_id")
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  sortOrder  Int      @default(0) @map("sort_order")
  assignedAt DateTime @default(now()) @map("assigned_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("product_categories")
}

model Inventory {
  id            String              @id @default(uuid()) @map("_id")
  variantId     String              @unique @map("variant_id")
  stockOnHand   Int                 @default(0) @map("stock_on_hand")
  stockReserved Int                 @default(0) @map("stock_reserved")
  minimumStock  Int                 @default(0) @map("minimum_stock")
  version       Int                 @default(0)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  variant       ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements     InventoryMovement[]

  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @map("_id")
  inventoryId   String                @map("inventory_id")
  type          InventoryMovementType
  quantity      Int
  stockBefore   Int                   @map("stock_before")
  stockAfter    Int                   @map("stock_after")
  reason        String
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  adminUserId   String?               @map("admin_user_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  inventory     Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  adminUser     User?                 @relation("InventoryMovementAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@index([adminUserId, createdAt])
  @@map("inventory_movements")
}

model Cart {
  id             String     @id @default(uuid()) @map("_id")
  guestTokenHash String?    @map("guest_token_hash")
  customerId     String?    @map("customer_id")
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime   @map("expires_at")
  version        Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  items          CartItem[]
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          Order?

  @@index([status, expiresAt])
  @@index([customerId, status, updatedAt])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id                       String         @id @default(uuid()) @map("_id")
  cartId                   String         @map("cart_id")
  variantId                String         @map("variant_id")
  quantity                 Int
  unitPriceSnapshotInCents BigInt         @map("unit_price_snapshot_in_cents")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  cart                     Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant                  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model ShippingMethod {
  id                      String             @id @default(uuid()) @map("_id")
  code                    String             @unique
  name                    String
  description             String?
  type                    ShippingMethodType
  costInCents             BigInt             @default(0) @map("cost_in_cents")
  requiresAddress         Boolean            @default(true) @map("requires_address")
  minimumSubtotalInCents  BigInt?            @map("minimum_subtotal_in_cents")
  freeShippingFromInCents BigInt?            @map("free_shipping_from_in_cents")
  isActive                Boolean            @default(true) @map("is_active")
  sortOrder               Int                @default(0) @map("sort_order")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  orders                  Order[]

  @@index([isActive, sortOrder, name])
  @@map("shipping_methods")
}

model Order {
  id                         String               @id @default(uuid()) @map("_id")
  number                     BigInt               @unique @map("order_number")
  cartId                     String               @unique @map("cart_id")
  customerId                 String?              @map("customer_id")
  shippingMethodId           String               @map("shipping_method_id")
  checkoutKeyHash            String               @unique @map("checkout_key_hash")
  guestAccessTokenHash       String?              @map("guest_access_token_hash")
  status                     OrderStatus          @default(PENDING_PAYMENT)
  currency                   String               @default("ARS")
  buyerFirstName             String               @map("buyer_first_name")
  buyerLastName              String               @map("buyer_last_name")
  buyerEmail                 String               @map("buyer_email")
  buyerPhone                 String               @map("buyer_phone")
  shippingMethodName         String               @map("shipping_method_name")
  shippingMethodType         ShippingMethodType   @map("shipping_method_type")
  shippingRequiresAddress    Boolean              @map("shipping_requires_address")
  shippingRecipientFirstName String?              @map("shipping_recipient_first_name")
  shippingRecipientLastName  String?              @map("shipping_recipient_last_name")
  shippingPhone              String?              @map("shipping_phone")
  shippingStreet             String?              @map("shipping_street")
  shippingStreetNumber       String?              @map("shipping_street_number")
  shippingFloorApartment     String?              @map("shipping_floor_apartment")
  shippingCity               String?              @map("shipping_city")
  shippingProvince           String?              @map("shipping_province")
  shippingPostalCode         String?              @map("shipping_postal_code")
  shippingReferences         String?              @map("shipping_references")
  itemsSubtotalInCents       BigInt               @map("items_subtotal_in_cents")
  shippingAmountInCents      BigInt               @map("shipping_amount_in_cents")
  discountAmountInCents      BigInt               @default(0) @map("discount_amount_in_cents")
  totalInCents               BigInt               @map("total_in_cents")
  paymentExpiresAt           DateTime             @map("payment_expires_at")
  reservationReleasedAt      DateTime?            @map("reservation_released_at")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")
  cart                       Cart                 @relation(fields: [cartId], references: [id], onDelete: Restrict)
  customer                   Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingMethod             ShippingMethod       @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  notes                      OrderNote[]

  @@index([customerId, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([status, createdAt])
  @@index([shippingMethodId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(uuid()) @map("_id")
  orderId          String          @map("order_id")
  productId        String?         @map("product_id")
  productVariantId String?         @map("product_variant_id")
  productName      String          @map("product_name")
  variantName      String          @map("variant_name")
  sku              String
  unitPriceInCents BigInt          @map("unit_price_in_cents")
  quantity         Int
  subtotalInCents  BigInt          @map("subtotal_in_cents")
  createdAt        DateTime        @default(now()) @map("created_at")
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @map("_id")
  orderId     String       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  reason      String
  actorUserId String?      @map("actor_user_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User?        @relation("OrderStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
  @@map("order_status_history")
}

model OrderNote {
  id          String   @id @default(uuid()) @map("_id")
  orderId     String   @map("order_id")
  actorUserId String   @map("actor_user_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       User     @relation("OrderNoteActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("order_notes")
}

model AuditLog {
  id          String   @id @default(uuid()) @map("_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model StoreSettings {
  id                Int      @id @default(1) @map("_id")
  storeName         String   @map("store_name")
  publicEmail       String   @map("public_email")
  phone             String?
  whatsapp          String?
  businessAddress   String?  @map("business_address")
  instagramUrl      String?  @map("instagram_url")
  facebookUrl       String?  @map("facebook_url")
  publicDescription String?  @map("public_description")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Sequence {
  id        String   @id @map("_id")
  value     BigInt
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sequences")
}
