# Copiar a .env.backup.local (ignorado por Git). No publicar valores reales.
BACKUP_MONGODB_URI=
# Confirmar solo durante una ventana real sin escrituras.
BACKUP_CONSISTENCY_MODE=
# Solo MongoDB Server 8.0 local y separado en 127.0.0.1:27018, con base nueva lauril_restore_*.
# Dejar vacío para generar backup con restauración pendiente.
BACKUP_RESTORE_URI=
BACKUP_RESTORE_ALLOWED_TARGET=
